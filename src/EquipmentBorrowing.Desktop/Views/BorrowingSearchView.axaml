<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingSearchView">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">
        <TextBlock Grid.Row="0" Text="Search Borrowings" Classes="Heading"/>

        <WrapPanel Grid.Row="1" Margin="0,12,0,4">
            <StackPanel Classes="FormField" Margin="0,0,12,8">
                <TextBlock Text="Student name/number or equipment name" Classes="Label"/>
                <TextBox Text="{Binding SearchText}" MinWidth="260" MaxLength="100"/>
            </StackPanel>

            <StackPanel Classes="FormField" Margin="0,0,12,8">
                <TextBlock Text="Status" Classes="Label"/>
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          MinWidth="150"/>
            </StackPanel>

            <StackPanel Classes="FormField" Margin="0,0,12,8">
                <TextBlock Text="Sort" Classes="Label"/>
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"
                          MinWidth="240"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <Button Content="Search" Classes="Primary" Command="{Binding SearchCommand}"/>
                <Button Content="Clear" Command="{Binding ClearCommand}"/>
            </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,8">
            <StackPanel IsVisible="{Binding IsLoading}" Spacing="4">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock Text="Loading borrowings..."/>
            </StackPanel>

            <TextBlock Text="{Binding ResultSummary}" IsVisible="{Binding HasRows}" Foreground="Gray"/>

            <TextBlock Text="No borrowings match these criteria."
                       IsVisible="{Binding IsEmpty}" Foreground="Gray"/>

            <StackPanel IsVisible="{Binding HasError}" Spacing="6">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="ErrorMessage"/>
                <Button Content="Retry" Command="{Binding SearchCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <views:BorrowingTable Grid.Row="3"/>
    </Grid>
</UserControl>