<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingTable">

    <!-- No DataContext set here on purpose: it inherits the parent's ViewModel,
         which must expose Rows and HasRows. -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasRows}">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,100,110,100,80" Margin="8,4">
            <TextBlock Grid.Column="0" Text="Student" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Equipment" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Borrowed" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Expected return" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Returned" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,*,100,110,100,80" Margin="4">
                        <TextBlock Grid.Column="0" Text="{Binding StudentLabel}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{Binding EquipmentLabel}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{Binding DateBorrowedText}"/>
                        <TextBlock Grid.Column="3" Text="{Binding ExpectedReturnText}"/>
                        <TextBlock Grid.Column="4" Text="{Binding ReturnedText}"/>
                        <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontWeight="SemiBold"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>