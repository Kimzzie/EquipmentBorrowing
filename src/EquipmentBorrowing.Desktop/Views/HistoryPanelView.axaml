<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.HistoryPanelView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
        <StackPanel Grid.Row="0" IsVisible="{Binding HasSelection}" Margin="0,0,0,8">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Subtitle}" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding Prompt}" IsVisible="{Binding ShowPrompt}" Foreground="Gray"/>

            <StackPanel IsVisible="{Binding IsLoading}" Spacing="4">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock Text="Loading history..."/>
            </StackPanel>

            <TextBlock Text="No borrowing history yet for this selection."
                       IsVisible="{Binding IsEmpty}" Foreground="Gray"/>

            <StackPanel IsVisible="{Binding HasError}" Spacing="6">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="ErrorMessage"/>
                <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <views:BorrowingTable Grid.Row="2"/>
    </Grid>
</UserControl>