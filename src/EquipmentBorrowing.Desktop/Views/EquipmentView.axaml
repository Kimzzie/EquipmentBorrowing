<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EquipmentBorrowing.Desktop.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView">

    <UserControl.Resources>
        <converters:BoolToAvailabilityConverter x:Key="BoolToAvailabilityConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Equipment" Classes="Heading"/>

        <!-- Filter, loading, empty and error states -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
            <CheckBox Content="Show available only" IsChecked="{Binding ShowAvailableOnly}"/>

            <StackPanel IsVisible="{Binding IsLoading}" Spacing="4">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock Text="Loading equipment..."/>
            </StackPanel>

            <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" Foreground="Gray"/>

            <StackPanel IsVisible="{Binding HasLoadError}" Spacing="6">
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Classes="ErrorMessage"/>
                <Button Content="Retry" Command="{Binding LoadCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding EquipmentList}"
                 SelectedItem="{Binding SelectedEquipment}"
                 Margin="0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="90,*,2*,120" Margin="4">
                        <TextBlock Grid.Column="0" Text="{Binding EquipmentCode}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="Gray"/>
                        <TextBlock Grid.Column="3" Text="{Binding IsAvailable, Converter={StaticResource BoolToAvailabilityConverter}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Classes="FormField" Margin="0,0,0,8">
            <TextBlock Text="Student" Classes="Label"/>
            <ComboBox ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      MinWidth="250"
                      MaxWidth="320"
                      HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Classes="FormField" Margin="0,0,0,8">
            <TextBlock Text="Return Date" Classes="Label"/>
            <DatePicker SelectedDate="{Binding ExpectedReturnDate, Mode=TwoWay}"
                        HorizontalAlignment="Left"/>
        </StackPanel>

        <WrapPanel Grid.Row="5" Margin="0,0,0,8">
            <Button Content="Borrow selected item"
                    Classes="Primary"
                    Command="{Binding BorrowCommand}"
                    Margin="0,0,8,8"/>
            <Button Content="Add to checkout list"
                    Command="{Binding AddToCheckoutCommand}"
                    Margin="0,0,8,8"/>
        </WrapPanel>

        <!-- UC-06: several items for one student, all or nothing -->
        <StackPanel Grid.Row="6" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="Checkout list (several items at once)" Classes="Label"/>
            <ListBox ItemsSource="{Binding CheckoutItems}"
                     SelectedItem="{Binding SelectedCheckoutItem}"
                     MinHeight="40" MaxHeight="120">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="90,*" Margin="4">
                            <TextBlock Grid.Column="0" Text="{Binding EquipmentCode}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel>
                <Button Content="Remove selected" Command="{Binding RemoveFromCheckoutCommand}" Margin="0,0,8,8"/>
                <Button Content="Clear list" Command="{Binding ClearCheckoutCommand}" Margin="0,0,8,8"/>
                <Button Content="Check out all" Classes="Primary" Command="{Binding CheckOutCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
        </StackPanel>

        <TextBlock Grid.Row="7"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Classes.ErrorMessage="{Binding IsError}"
                   Classes.SuccessMessage="{Binding !IsError}"/>
    </Grid>
</UserControl>