<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
             x:Class="EquipmentBorrowing.Desktop.Views.HistoryView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="20">
        <TextBlock Grid.Row="0" Text="Borrowing History" Classes="Heading"/>

        <StackPanel Grid.Row="1" IsVisible="{Binding HasListError}" Spacing="6" Margin="0,8">
            <TextBlock Text="{Binding ListError}" TextWrapping="Wrap" Classes="ErrorMessage"/>
            <Button Content="Retry" Command="{Binding LoadCommand}" HorizontalAlignment="Left"/>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,12,0,0">
            <TabItem Header="By student">
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="Student" Classes="Label"/>
                    <ComboBox ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              MinWidth="300" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding StudentNumber}" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <views:HistoryPanelView DataContext="{Binding StudentPanel}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="By equipment">
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="Equipment" Classes="Label"/>
                    <ComboBox ItemsSource="{Binding EquipmentItems}"
                              SelectedItem="{Binding SelectedEquipmentItem}"
                              MinWidth="300" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding EquipmentCode}" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <views:HistoryPanelView DataContext="{Binding EquipmentPanel}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>