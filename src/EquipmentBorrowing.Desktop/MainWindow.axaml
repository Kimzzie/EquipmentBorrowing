<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="clr-namespace:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.MainWindow"
        Title="Campus Equipment Borrowing System"
        Width="1000" Height="640"
        MinWidth="400" MinHeight="300">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:EquipmentViewModel">
            <views:EquipmentView />
        </DataTemplate>
        <DataTemplate DataType="vm:BorrowingsViewModel">
            <views:BorrowingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:BorrowingSearchViewModel">
            <views:BorrowingSearchView />
        </DataTemplate>
        <DataTemplate DataType="vm:HistoryViewModel">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:StudentsViewModel">
            <views:StudentsView />
        </DataTemplate>
        <DataTemplate DataType="vm:EquipmentManagementViewModel">
            <views:EquipmentManagementView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="190,*">
        <StackPanel Grid.Column="0" Classes="NavPanel" IsEnabled="{Binding IsReady}">
            <TextBlock Text="Campus Equipment" Classes="SidebarTitle" Margin="12,16,12,20"/>
            <Button Content="Equipment" Classes="NavButton" Command="{Binding ShowEquipmentCommand}"/>
            <Button Content="Active Borrowings" Classes="NavButton" Command="{Binding ShowBorrowingsCommand}"/>
            <Button Content="Search Borrowings" Classes="NavButton" Command="{Binding ShowBorrowingSearchCommand}"/>
            <Button Content="History" Classes="NavButton" Command="{Binding ShowHistoryCommand}"/>
            <Button Content="Students" Classes="NavButton" Command="{Binding ShowStudentsCommand}"/>
            <Button Content="Manage Equipment" Classes="NavButton" Command="{Binding ShowEquipmentManagementCommand}"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <ScrollViewer IsVisible="{Binding IsReady}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsStarting}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="220"/>
                <TextBlock Text="Connecting to PostgreSQL..." HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasStartupError}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="460" Margin="20" Spacing="12">
                <TextBlock Text="Cannot start the application" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StartupError}" TextWrapping="Wrap"/>
                <Button Content="Retry" Classes="Primary"
                        Command="{Binding RetryStartupCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>